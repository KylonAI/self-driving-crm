{
  "name": "crm-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node --import tsx scripts/generate-contracts.ts",
    "dev": "next dev",
    "generate:contracts": "node --import tsx scripts/generate-contracts.ts",
    "prebuild": "node --import tsx scripts/generate-contracts.ts && node scripts/upload-contract-snapshot.mjs",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test lib/*.test.ts lib/**/*.test.ts components/ui/data-table/*.test.ts",
    "test:time": "tsx --test lib/time/*.test.ts lib/time/**/*.test.ts",
    "validate": "pnpm validate:push",
    "validate:push": "node scripts/validate-push.mjs",
    "typecheck": "pnpm validate:push"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.18.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-native": "npm:typescript@7.0.2"
  },
  "packageManager": "pnpm@10.8.0",
  "description": "Blank CRM template: B2B, VC, partnerships or recruiting, with guided Setup that connects the Room's Automations."
}
